# Copy this file to .env.local and fill in your keys. .env.local is git-ignored.
# All API keys MUST stay server-side. Never prefix them with NEXT_PUBLIC_.
#
# NOTE: The NGN Market and Claude API keys can also be entered (and are then
# encrypted at rest) from the in-app Admin → Settings page — no restart needed.
# A key set here is used only when none has been saved in the app.

# REQUIRED — Postgres connection string. The app no longer carries an embedded
# database, so local dev needs a real Postgres. Easiest option: create a free
# Neon *dev branch* and paste its pooled connection string here — that keeps
# local work off the production data entirely.
#
#   DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# A local Postgres works too:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/brb_dev
#
# On first successful connection the app creates its schema (all statements are
# idempotent) and seeds the three staff accounts using BRB_SEED_PASSWORD.
DATABASE_URL=

# Shared secret for the /api/cron/* endpoints (alert + engine cadences).
# Only needed locally if you want to exercise those routes:
#   curl -X POST localhost:3000/api/cron/alerts -H "Authorization: Bearer <value>"
# CRON_SECRET=any-value-for-local-testing

# Your live NGN Market API key (https://ngnmarket.com/developer)
NGNMARKET_API_KEY=ngm_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the API base URL (defaults to the production v1 endpoint)
# NGNMARKET_BASE_URL=https://api.ngnmarket.com/v1

# Password used to seed the initial staff accounts (analyst@ / pm@ / admin@brb.local)
# on first boot. CHANGE THIS and rotate the seeded accounts before any real use.
BRB_SEED_PASSWORD=brb-demo-pass

# Claude API key for the AI daily market summary + filing extraction
# (https://console.anthropic.com/settings/keys). Server-side only.
# ANTHROPIC_API_KEY=sk-ant-...

# Master secret used to encrypt API keys saved via the admin UI (AES-256-GCM).
# Set a strong random value in production. If unset, a value is derived from
# BRB_SEED_PASSWORD. Rotating this makes previously saved keys unreadable — they
# must be re-entered in Admin → Settings.
# APP_ENCRYPTION_KEY=change-me-to-a-long-random-string
