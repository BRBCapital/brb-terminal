# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env — API keys live here, never commit.
# Ignore EVERY .env variant (.env.production, .env.staging, …) and re-admit only
# the committed *.example templates. The previous narrow rules let a filled-in
# .env.production be committed with live secrets.
.env*
!.env*.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/*
!.vscode/extensions.json
.idea

# typescript
*.tsbuildinfo

# local embedded Postgres (PGlite) data
/.data/
