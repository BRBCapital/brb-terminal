# ─────────────────────────────────────────────────────────────────────────────
# BRB NGX Analyst — production environment template
# Copy to a secure, root-owned file on the server (e.g. /etc/brb/brb.env, chmod 600).
# NEVER commit the filled-in version. Fill every REQUIRED value before first boot.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — enables secure cookies + the encryption-key safety check.
NODE_ENV=production

# REQUIRED — master secret that encrypts stored API keys (AES-256-GCM).
# Generate ONCE and keep it STABLE forever — changing it makes previously saved
# in-app keys unreadable. Generate with:  openssl rand -hex 32
APP_ENCRYPTION_KEY=

# REQUIRED — password for the three seeded staff accounts created on first boot
# (analyst@brb.local / pm@brb.local / admin@brb.local). Use a strong value and
# rotate/remove those accounts after go-live. Keep it stable (it also seeds users
# only once). Generate with:  openssl rand -base64 24
BRB_SEED_PASSWORD=

# REQUIRED for live market data — NGN Market API key (ngm_live_...).
# The server's egress IP (the EC2 Elastic IP / NAT IP) must be allow-listed in
# the NGN Market dashboard.
NGNMARKET_API_KEY=

# REQUIRED for AI features — Anthropic/Claude API key (sk-ant-...).
# Env keys are used directly (never encrypted), so this is the robust place for it.
ANTHROPIC_API_KEY=

# RECOMMENDED — absolute path to the database directory on the PERSISTENT (EBS)
# volume. This directory IS the entire database — back it up (EBS snapshots).
PGLITE_DIR=/var/lib/brb/pg

# OPTIONAL — server port (default 3000). Bind the reverse proxy to it.
PORT=3000

# OPTIONAL — override the NGN Market base URL (defaults to the production v1 API).
# NGNMARKET_BASE_URL=https://api.ngnmarket.com/v1

# ── Member portal: email verification (OPTIONAL) ─────────────────────────────
# Public origin of the app; used to build member email-verification links.
# APP_BASE_URL=https://analyst.brbcapital.example
# SMTP transport for verification emails. WITHOUT these the app only LOGS the
# verification link (acceptable internally) instead of emailing it.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM="Alternative Strategies <no-reply@brbcapital.example>"

# ── Public signup CAPTCHA (OPTIONAL — Cloudflare Turnstile) ───────────────────
# Both must be set to activate the challenge on public member signup (inert
# otherwise). NOTE: NEXT_PUBLIC_* values are inlined at BUILD time — they must be
# present during `npm run build`, not only in the runtime env file.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# OPTIONAL — public origin exposed to the browser bundle (build-time inlined).
# NEXT_PUBLIC_APP_URL=https://analyst.brbcapital.example
